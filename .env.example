# Google GenAI key used by the annotation parser and as the default inference key.
GOOGLE_API_KEY=
# Optional explicit Google GenAI key; takes precedence over GOOGLE_API_KEY for annotation.
GEMINI_API_KEY=

# Optional Hugging Face authentication for gated models and higher Hub limits.
HF_TOKEN=

# Annotation notebooks.
# Set to 0 for unlimited rows; otherwise this caps attempted rows per run.
ANNOTATE_LIMIT=10
# Set to 0 to disable streaming dataset reads.
ANNOTATE_STREAMING=1
ANNOTATE_LLM=google/gemini-2.5-flash-lite
ANNOTATE_GROUNDER=IDEA-Research/grounding-dino-tiny
ANNOTATE_BOX_THRESHOLD=0.35
ANNOTATE_TEXT_THRESHOLD=0.25
# Optional override; defaults to a benchmark-specific folder under .out/annotation.
ANNOTATE_OUT=
COMPBENCH_TASKS=add,remove,replace,multi_object_add,multi_object_remove
MAGICBRUSH_SPLIT=dev

# Optional annotation JSONL overrides; inference defaults to generated files under .out/annotation/.
MMEDIT_COMPBENCH_ANNOTATIONS=
MMEDIT_REFEDIT_BENCH_ANNOTATIONS=

# Benchmark inference.
MMEDIT_MODEL_ID=gemini-2.5-flash
MMEDIT_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Set this for non-Google OpenAI-compatible providers; otherwise GOOGLE_API_KEY is used.
MMEDIT_API_KEY=
MMEDIT_COMPBENCH_OUTPUT_DIR=
MMEDIT_REFEDIT_BENCH_OUTPUT_DIR=
# Optional RefEdit-Bench run directory for metrics; empty selects the latest run.
MMEDIT_REFEDIT_BENCH_RUN=

# Optional RefEdit-Bench Modified VIEScore evaluator.
# VIESCORE_ROOT should point to Step1X-Edit/GEdit-Bench.
VIESCORE_ROOT=
# Path to a local file whose first line contains the OpenAI API key for GPT-4o scoring.
VIESCORE_KEY_PATH=